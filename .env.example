# ------------------------------------------------------------------
# Fatura Onay Sistemi — ortam değişkenleri
# ------------------------------------------------------------------

# Yerel geliştirme için SQLite (kutudan çıkar çıkmaz çalışır):
DATABASE_URL="file:./dev.db"

# Vercel / production için Postgres kullanın (Vercel Postgres veya Neon).
# Bu durumda prisma/schema.prisma içindeki datasource provider'ını
# "postgresql" yapın ve aşağıdaki gibi bir bağlantı adresi verin:
# DATABASE_URL="postgres://KULLANICI:SIFRE@HOST/VERITABANI?sslmode=require"

# Oturum çerezlerini imzalamak için gizli anahtar.
# Güçlü rastgele bir değer üretin:  openssl rand -base64 32
AUTH_SECRET="degistir-bu-degeri-uzun-rastgele-bir-anahtarla"
